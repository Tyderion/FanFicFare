    "version": "2.0.0",
    "tasks": [
        {
            "label": "pipInstall",
            "type": "shell",
            "command": "pip install ${workspaceFolder}",
            "dependsOn": "removeEpubs"
        },
        {
            "label": "removeEpubs",
            "type": "shell",
            "command": "rm -Force *.epub"
        }
    ]
}